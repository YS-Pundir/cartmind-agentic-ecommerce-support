FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# requirements.txt is UTF-16 (frozen on Windows) and contains Windows-only pywin32.
COPY requirements.txt .
RUN iconv -f utf-16 -t utf-8 requirements.txt | tr -d '\r' \
    | grep -v -i '^pywin32' > requirements.linux.txt \
    && pip install -r requirements.linux.txt \
        --extra-index-url https://download.pytorch.org/whl/cpu

# Bake the embedding model into the image so the container works offline / starts fast
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY . .

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "src.agent.main:app", "--host", "0.0.0.0", "--port", "8000"]
